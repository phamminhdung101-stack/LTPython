# ==============================================================
# DOCUNI - CẤU HÌNH MÔI TRƯỜNG & CLOUDINARY STORAGE
# ==============================================================

# Nếu muốn lưu trữ tài liệu lên Cloudinary khi Deploy Web:
# Đăng ký tài khoản miễn phí tại: https://cloudinary.com
# Vào Dashboard copy 3 thông số này dán vào đây:

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Nếu không điền 3 thông số trên, hệ thống sẽ tự động lưu file cục bộ (Local Storage).
