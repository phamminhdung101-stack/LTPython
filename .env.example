# ==============================================================
# DOCUNI - CẤU HÌNH MÔI TRƯỜNG & DATABASE POSTGRESQL & AI
# ==============================================================

# 1. Cơ sở dữ liệu PostgreSQL
DB_NAME=kho_tai_lieu_mon_hoc
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# 2. Cấu hình AI RAG & Mô hình ngôn ngữ lớn (Tùy chọn)
# Hệ thống đã tích hợp sẵn bộ Semantic Hashing + Extractive Synthesizer nội bộ
# Nếu có OpenAI hoặc Gemini API Key, điền vào đây để sử dụng mô hình tạo sinh trực tuyến:
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Lưu trữ đám mây Cloudflare R2 / Cloudinary (Tùy chọn)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Nếu không cấu hình Cloudinary, hệ thống tự động lưu trữ file cục bộ tại thư mục media/
